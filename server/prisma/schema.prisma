datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id      String   @id // Например: 'uk_vostok', 'uk_zapad'
  name    String   // Название: 'УК Восток-Сервис'
  
  users   User[]
  tickets Ticket[]
  houses  House[]  // Новая связь: одной компании принадлежит много домов

  residents Resident[]
}

model Resident {
  id          Int      @id @default(autoincrement())
  maxUserId   String   @unique // ID пользователя внутри МАХ (из вебхука или WebApp initData)
  phone       String?  // Телефон для связи мастера с жителем
  name        String?  // Имя или никнейм из профиля МАХ
  apartment   String?  // Номер квартиры (например, "42")
  
  // Привязка к адресу и УК
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  houseId     Int?
  house       House?   @relation(fields: [houseId], references: [id])

  tickets     Ticket[] // История всех заявок жителя
  createdAt   DateTime @default(now())

  @@map("residents")
}

model House {
  id        Int        @id @default(autoincrement())
  address   String     // "ул. Ленина, д. 10"
  
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])

  residents Resident[] // Жители этого дома
  tickets   Ticket[]   // Заявки по этому дому

  @@unique([address, companyId])
  @@map("houses")
}

model User {
  id        Int      @id @default(autoincrement())
  phone     String   @unique // Логин будет по телефону
  password  String   // Хэшированный bcrypt'ом пароль
  name      String   // Имя мастера или диспетчера (например, "Петрович")
  role      String   // 'admin', 'dispatcher', 'master'
  
  companyId String   // К какой УК привязан сотрудник
  company   Company  @relation(fields: [companyId], references: [id])

  tickets   Ticket[] @relation("MasterTickets")
}

model ValidToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  role      String   // "DISPATCHER" или "MASTER"
  phone     String
  companyId String   // К какой УК привязан инвайт
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("valid_tokens")
}

model Ticket {
  id             Int           @id @default(autoincrement())
  address        String        // Полная строка адреса или дубль для истории ("ул. Ленина, д. 10, кв. 42")
  apartment      String?       // Отдельное поле квартиры для удобства фильтрации
  description    String
  type           String        // 'emergency' или 'regular'
  status         String        // 'new', 'in_work', 'completed'

  createdAt      DateTime      @default(now())
  assignedAt     DateTime?
  completedAt    DateTime?

  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])

  // Связь с домом (опционально, для быстрого поиска всех аварий дома)
  houseId        Int?
  house          House?        @relation(fields: [houseId], references: [id])

  // КТО ОСТАВИЛ ЗАЯВКУ (Житель из МАХ)
  residentId     Int?
  resident       Resident?     @relation(fields: [residentId], references: [id])

  masterId       Int?
  master         User?         @relation("MasterTickets", fields: [masterId], references: [id])

  photos         TicketPhoto[]

  managerRating  Int?
  managerComment String?
}

model TicketPhoto {
  id        Int      @id @default(autoincrement())
  url       String   // Ссылка на фото в S3
  createdAt DateTime @default(now())

  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model MeterReading {
  id        Int      @id @default(autoincrement())
  companyId String
  address   String   // К какому адресу привязаны показания
  type      String   // ХВС, ГВС, ЭЭ
  value     Float
  createdAt DateTime @default(now())

  @@map("meter_readings")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}